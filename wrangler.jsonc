{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "events-relaton-org",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "events.relaton.org", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "events-relaton-org",
      "database_id": "fe95ff03-c853-4b02-87f3-5f812adc9a83"
    }
  ]
}
