{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "events-relaton-org",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "events.relaton.org", "custom_domain": true }]
